# ── データベース (PostgreSQL / Neon) ─────────────────────────────
# アプリ実行時に使うプール接続。Neon の "-pooler" が付いたホスト、末尾に ?sslmode=require
# 例: postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# マイグレーション / prisma db push 用の直結（非プール）接続。"-pooler" が付かないホスト。
# Vercel の Neon 連携では自動でこの名前の環境変数が注入される。
# 例: postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── 認証 ─────────────────────────────────────────────────────────
# セッションJWT署名用シークレット。`openssl rand -base64 32` などで生成した値を設定
AUTH_SECRET="please-set-a-long-random-secret"
